---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import Card from "@components/Card";
import type { CollectionEntry } from "astro:content";
import slugify, { slugifyStr } from "@utils/slugify";
import { getReadingTime } from "@utils/getReadingTime";

export interface Props {
  post: CollectionEntry<"blog">;
  posts?: CollectionEntry<"blog">[];
}

const { post, posts = [] } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  tags,
  category,
} = post.data;

const { Content, headings } = await post.render();

const ogUrl = new URL(
  ogImage ? ogImage : `${slugify(post.data)}.png`,
  Astro.site ?? Astro.url.origin
).href;

const readingTime = getReadingTime(post.body);

const yearsOld = Math.floor(
  (Date.now() - new Date(pubDatetime).getTime()) / (1000 * 60 * 60 * 24 * 365.25)
);

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

const currentSlug = slugify(post.data);
const currentIndex = posts.findIndex(p => slugify(p.data) === currentSlug);
const newerPost = currentIndex > 0 ? posts[currentIndex - 1] : null;
const olderPost =
  currentIndex >= 0 && currentIndex < posts.length - 1
    ? posts[currentIndex + 1]
    : null;

const currentTagSlugs = new Set(tags.map(t => slugifyStr(t)));
const relatedPosts = posts
  .filter(p => slugify(p.data) !== currentSlug)
  .map(p => {
    const matchCount = p.data.tags.filter(t =>
      currentTagSlugs.has(slugifyStr(t))
    ).length;
    return { post: p, matchCount };
  })
  .filter(item => item.matchCount > 0)
  .sort((a, b) => {
    if (b.matchCount !== a.matchCount) {
      return b.matchCount - a.matchCount;
    }
    return (
      b.post.data.pubDatetime.getTime() - a.post.data.pubDatetime.getTime()
    );
  })
  .slice(0, 3)
  .map(item => item.post);
---

<Layout
  title={title}
  author={author}
  description={description}
  ogImage={ogUrl}
  canonicalURL={canonicalURL}
>
  <div
    id="progress-container"
    class="pointer-events-none fixed left-0 top-0 z-50 h-1 w-full bg-transparent"
    aria-hidden="true"
  >
    <div id="progress-bar" class="h-1 w-0 bg-skin-accent transition-all duration-75"></div>
  </div>

  <Header />
  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button
      class="focus-outline mb-2 mt-8 flex items-center gap-1 rounded px-2 py-1 text-sm hover:text-skin-accent"
      onclick="history.back()"
      type="button"
    >
      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
        ><path
          d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
        ></path>
      </svg><span>Go back</span>
    </button>
  </div>

  <main id="main-content">
    <header class="post-header">
      {
        category && (
          <div class="mb-2">
            <span class="rounded bg-skin-accent bg-opacity-15 px-2.5 py-0.5 font-code text-xs font-semibold text-skin-accent">
              {category}
            </span>
          </div>
        )
      }
      <h1 class="post-title">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
        <Datetime datetime={pubDatetime} size="lg" />
        <span class="flex items-center gap-1.5 font-code text-sm opacity-80">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="!h-4 !w-4 !fill-none"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{readingTime}</span>
        </span>
      </div>
      {
        tags && tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Post tags">
            {tags.map(tag => (
              <li>
                <a
                  href={`/tags/${slugifyStr(tag)}`}
                  class="inline-block rounded border border-skin-line bg-skin-card bg-opacity-50 px-2 py-0.5 font-code text-xs transition-colors hover:border-skin-accent hover:text-skin-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-accent"
                >
                  #{tag.toLowerCase()}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      yearsOld >= 3 && (
        <aside
          class="my-6 flex items-start gap-3 rounded-lg border border-skin-accent border-opacity-40 bg-skin-card bg-opacity-60 p-4 text-sm"
          role="note"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mt-0.5 !h-5 !w-5 shrink-0 !fill-none text-skin-accent"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <p class="leading-relaxed">
            この記事は公開から <strong>{yearsOld}年以上</strong> 経過しています。現在のクラウドサービスの仕様やベストプラクティスとは異なる場合があります。
          </p>
        </aside>
      )
    }

    {
      tocHeadings.length >= 2 && (
        <nav
          aria-label="目次"
          class="my-6 rounded-lg border border-skin-line bg-skin-card bg-opacity-40 p-4"
        >
          <h2 class="mb-2 font-code text-xs font-semibold uppercase tracking-wider text-skin-accent">
            Table of Contents / 目次
          </h2>
          <ul class="space-y-1.5 text-sm">
            {tocHeadings.map(heading => (
              <li class={heading.depth === 3 ? "pl-4" : ""}>
                <a
                  href={`#${heading.slug}`}
                  class="inline-block underline decoration-dashed underline-offset-4 opacity-85 hover:text-skin-accent hover:opacity-100"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <article id="article" role="article" class="prose mx-auto mt-8 max-w-3xl">
      <Content />
    </article>

    <ul class="tags-container">
      {tags.map(tag => <Tag name={slugifyStr(tag)} />)}
    </ul>

    {
      (newerPost || olderPost) && (
        <nav
          aria-label="前後記事ナビゲーション"
          class="my-8 grid grid-cols-1 gap-4 border-t border-skin-line pt-6 sm:grid-cols-2"
        >
          <div>
            {olderPost && (
              <a
                href={`/posts/${slugify(olderPost.data)}`}
                class="group flex h-full flex-col justify-between rounded-lg border border-skin-line bg-skin-card bg-opacity-40 p-4 transition-colors hover:border-skin-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-accent"
              >
                <span class="font-code text-xs uppercase tracking-wider opacity-70">
                  &larr; Previous Post
                </span>
                <span class="mt-1 font-medium text-skin-accent group-hover:underline">
                  {olderPost.data.title}
                </span>
              </a>
            )}
          </div>
          <div>
            {newerPost && (
              <a
                href={`/posts/${slugify(newerPost.data)}`}
                class="group flex h-full flex-col justify-between rounded-lg border border-skin-line bg-skin-card bg-opacity-40 p-4 text-right transition-colors hover:border-skin-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-accent"
              >
                <span class="font-code text-xs uppercase tracking-wider opacity-70">
                  Next Post &rarr;
                </span>
                <span class="mt-1 font-medium text-skin-accent group-hover:underline">
                  {newerPost.data.title}
                </span>
              </a>
            )}
          </div>
        </nav>
      )
    }

    {
      relatedPosts.length > 0 && (
        <section class="mt-10 border-t border-skin-line pt-8 !px-0">
          <div class="mb-4 flex items-baseline justify-between">
            <h2 class="text-xl font-semibold tracking-wide">Related Posts</h2>
            <span class="font-code text-xs opacity-70">Same Tech Stack</span>
          </div>
          <ul>
            {relatedPosts.map(related => (
              <Card
                href={`/posts/${slugify(related.data)}`}
                frontmatter={related.data}
                body={related.body}
                secHeading={false}
              />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
  .post-title {
    @apply text-2xl font-semibold leading-snug text-skin-accent sm:text-3xl;
  }
  .tags-container {
    @apply my-8;
  }
</style>

<style is:global>
  .code-block-wrapper {
    position: relative;
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }
  .code-block-wrapper pre {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 2.25rem !important;
  }
  .copy-code-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10;
    border-radius: 0.375rem;
    border: 1px solid rgba(148, 163, 184, 0.35);
    background-color: rgba(15, 23, 42, 0.8);
    color: #e2e8f0;
    padding: 0.2rem 0.55rem;
    font-family: "JetBrains Mono", "Zen Kaku Gothic New", monospace;
    font-size: 0.75rem;
    line-height: 1.25;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .copy-code-btn:hover {
    border-color: #38bdf8;
    color: #38bdf8;
  }
  .copy-code-btn:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
  }
  .copy-code-btn.is-copied {
    border-color: #38bdf8;
    background-color: rgba(2, 132, 199, 0.9);
    color: #ffffff;
  }
</style>

<script>
  function updateProgressBar() {
    const progressBar = document.getElementById("progress-bar");
    if (!progressBar) return;

    const scrollTop =
      window.scrollY || document.documentElement.scrollTop || 0;
    const docHeight =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    const progress = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
    progressBar.style.width = `${progress}%`;
  }

  function attachCopyButtons() {
    const codeBlocks = document.querySelectorAll("#article pre");

    codeBlocks.forEach(pre => {
      if (pre.parentElement?.classList.contains("code-block-wrapper")) return;

      const wrapper = document.createElement("div");
      wrapper.className = "code-block-wrapper";

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const copyButton = document.createElement("button");
      copyButton.type = "button";
      copyButton.className = "copy-code-btn";
      copyButton.setAttribute("aria-label", "Copy code to clipboard");
      copyButton.textContent = "Copy";

      copyButton.addEventListener("click", async () => {
        const codeEl = pre.querySelector("code");
        const text = codeEl ? codeEl.innerText : pre.textContent ?? "";
        try {
          await navigator.clipboard.writeText(text);
          copyButton.textContent = "Copied!";
          copyButton.classList.add("is-copied");
          setTimeout(() => {
            copyButton.textContent = "Copy";
            copyButton.classList.remove("is-copied");
          }, 2000);
        } catch {
          copyButton.textContent = "Failed";
          setTimeout(() => {
            copyButton.textContent = "Copy";
          }, 2000);
        }
      });

      wrapper.appendChild(copyButton);
    });
  }

  window.addEventListener("scroll", updateProgressBar, { passive: true });
  updateProgressBar();
  attachCopyButtons();
</script>
