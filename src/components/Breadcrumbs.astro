---
// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1);

// if breadcrumb is トップ > 記事一覧（Nページ目） <etc>
// replace posts segment with a page label
breadcrumbList[0] === "posts" &&
  breadcrumbList.splice(0, 2, `記事一覧（${breadcrumbList[1] || 1}ページ目）`);

const segmentLabels: Record<string, string> = {
  posts: "記事一覧",
  tags: "タグ",
  search: "検索",
  about: "プロフィール",
};
---

<nav class="breadcrumb" aria-label="パンくずリスト">
  <ul>
    <li>
      <a href="/">トップ</a>
      <span aria-hidden="true">&#62;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class={`${index > 0 ? "lowercase" : "capitalize"}`}
              aria-current="page"
            >
              {/* make the last part lowercase in トップ > タグ > some-tag */}
              {segmentLabels[breadcrumb] ?? breadcrumb}
            </span>
          </li>
        ) : (
          <li>
            <a href={`/${breadcrumb}`}>{segmentLabels[breadcrumb] ?? breadcrumb}</a>
            <span aria-hidden="true">&#62;</span>
          </li>
        )
      )
    }
  </ul>
</nav>

<style>
  .breadcrumb {
    @apply mx-auto mb-1 mt-8 w-full max-w-3xl px-4;
  }
  .breadcrumb ul li {
    @apply inline;
  }
  .breadcrumb ul li a {
    @apply capitalize opacity-70;
  }
  .breadcrumb ul li span {
    @apply opacity-70;
  }
  .breadcrumb ul li:not(:last-child) a {
    @apply hover:opacity-100;
  }
</style>
