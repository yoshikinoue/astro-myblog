---
export interface Props {
  href: string;
  className?: string;
  ariaLabel?: string;
  title?: string;
  disabled?: boolean;
  ariaCurrent?: "page" | "step" | "location" | "date" | "time" | "true" | "false";
}

const {
  href,
  className,
  ariaLabel,
  title,
  disabled = false,
  ariaCurrent,
} = Astro.props;
---

<a
  href={disabled ? undefined : href}
  tabindex={disabled ? "-1" : "0"}
  class={`group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skin-accent focus-visible:ring-offset-2 focus-visible:ring-offset-skin-fill ${disabled ? "pointer-events-auto" : ""} ${className}`}
  aria-label={ariaLabel}
  title={title}
  aria-disabled={disabled}
  aria-current={ariaCurrent}
>
  <slot />
</a>

<style>
  a {
    @apply hover:text-skin-accent;
  }
</style>
